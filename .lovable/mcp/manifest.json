{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cqzsszhzqfcczstxwvak.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "expense-dashboard",
      "version": "0.1.0",
      "title": "Expense Dashboard"
    },
    "tools": [
      {
        "name": "list_expenses",
        "title": "List expenses",
        "description": "List the signed-in user's expenses, optionally filtered by date range, category or owner.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date (inclusive), YYYY-MM-DD."
            },
            "end_date": {
              "$ref": "#/properties/start_date",
              "description": "End date (inclusive), YYYY-MM-DD."
            },
            "category": {
              "type": "string",
              "description": "Category, e.g. Food, Milk, Transport."
            },
            "owner": {
              "type": "string",
              "enum": [
                "husband",
                "wife"
              ],
              "description": "Who spent it."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Max rows (default 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_expense",
        "title": "Add expense",
        "description": "Add a new expense for the signed-in user. Dates cannot be in the future.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Expense date, YYYY-MM-DD."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "description": "Category, e.g. Food, Milk, Transport, Other."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000000,
              "description": "Amount in rupees."
            },
            "owner": {
              "type": "string",
              "enum": [
                "husband",
                "wife"
              ],
              "description": "Who spent it."
            },
            "payment_method": {
              "type": "string",
              "enum": [
                "cash",
                "card",
                "online"
              ],
              "description": "Defaults to cash."
            },
            "description": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional note."
            }
          },
          "required": [
            "date",
            "category",
            "amount",
            "owner"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
